# Sunucu gizlileri: Vercel Environment Variables bölümünde tanımlayın.
# Bu dosya yalnız örnektir; gerçek anahtarı buraya yazmayın.
# Yerel deneme için değerleri .env.local dosyasına ekleyin (Git tarafından yok sayılır).
BILGE_AI_ENABLED=false
BILGE_AI_BASE_URL=https://api.b.ai/v1
BILGE_AI_MODEL=gpt-6-luna
BILGE_AI_API_KEY=
# En az 32 karakter rastgele gizli değer; IP'lerin tek yönlü özetlenmesinde kullanılır.
BILGE_AI_ID_SALT=
# Kalıcı, atomik kota deposu. Yoksa ortak anahtar kullanılmaz.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Başlangıç değerleri; sağlayıcıdaki gerçek maliyete göre ayarlayın.
BILGE_AI_DAILY_REQUESTS=20
BILGE_AI_DAILY_UNITS=100000
BILGE_AI_GLOBAL_DAILY_REQUESTS=500
BILGE_AI_GLOBAL_DAILY_UNITS=2000000
