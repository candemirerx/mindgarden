<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Paylaşılan tek dosya grubu: veri yedekleri (JSON/DOCX/PDF) Belgeler
      klasörüne yazılıp paylaşılır. Tüm harici depolamayı açmak yerine
      yalnızca kullanılan klasörler paylaşıma açılır.
    -->
    <external-path name="belgeler" path="Documents/" />
    <cache-path name="onbellek" path="." />
    <!-- Kameranın çektiği fotoğrafın geçici dosyası (mini galeri). -->
    <external-files-path name="kamera" path="Pictures/" />
</paths>
